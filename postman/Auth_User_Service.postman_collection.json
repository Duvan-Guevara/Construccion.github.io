{
  "info": {
    "name": "Auth User Service",
    "description": "Coleccion para probar registro, login, JWT, perfil, roles y recuperacion de contrasena.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro - exitoso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/registro",
              "host": ["{{base_url}}"],
              "path": ["auth", "registro"]
            }
          }
        },
        {
          "name": "Login - guardar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login exitoso', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('token', json.token);",
                  "}",
                  "if (json.user && json.user.id) {",
                  "  pm.environment.set('user_id', json.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Validar token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/validate",
              "host": ["{{base_url}}"],
              "path": ["auth", "validate"]
            }
          }
        },
        {
          "name": "Obtener usuario y perfil",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Recuperar contrasena",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset contrasena",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"token_recuperacion\",\n  \"password\": \"nuevaPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset"]
            }
          }
        }
      ]
    },
    {
      "name": "Perfil",
      "item": [
        {
          "name": "Crear o actualizar perfil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"3001234567\",\n  \"direccion\": \"Calle 123 #45-67\",\n  \"ciudad\": \"Bogota\",\n  \"foto\": \"https://example.com/foto.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/perfil",
              "host": ["{{base_url}}"],
              "path": ["auth", "perfil"]
            }
          }
        },
        {
          "name": "Obtener perfil",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/perfil/datos",
              "host": ["{{base_url}}"],
              "path": ["auth", "perfil", "datos"]
            }
          }
        },
        {
          "name": "Actualizar perfil",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"3015555555\",\n  \"direccion\": \"Carrera 10 #20-30\",\n  \"ciudad\": \"Cali\",\n  \"foto\": \"https://example.com/foto2.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/perfil/actualizar",
              "host": ["{{base_url}}"],
              "path": ["auth", "perfil", "actualizar"]
            }
          }
        },
        {
          "name": "Ruta protegida perfil",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/perfil",
              "host": ["{{base_url}}"],
              "path": ["auth", "perfil"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/usuarios",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios"]
            }
          }
        },
        {
          "name": "Cambiar rol",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"operador\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/usuarios/{{user_id}}/role",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios", "{{user_id}}", "role"]
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/auth/usuarios/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "usuarios", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Validar admin",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/admin",
              "host": ["{{base_url}}"],
              "path": ["auth", "admin"]
            }
          }
        }
      ]
    },
    {
      "name": "Errores controlados",
      "item": [
        {
          "name": "Login sin password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Validar sin token",
          "auth": {
            "type": "noauth"
          },
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/validate",
              "host": ["{{base_url}}"],
              "path": ["auth", "validate"]
            }
          }
        }
      ]
    }
  ]
}
